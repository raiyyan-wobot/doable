{
  "name": "doable",
  "version": "0.1.0",
  "description": "Doable: a local-first task manager",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tauri": "tauri",
    "tokens": "node --import ./scripts/resolve-js-extension.mjs scripts/generate-tokens.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "wdio run e2e/wdio.conf.js",
    "test:all": "pnpm test && pnpm test:rust && pnpm test:e2e",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "icon": "node scripts/generate-icon.mjs",
    "package:arch": "sh scripts/package-arch.sh",
    "check:version": "node scripts/check-version.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "@material/material-color-utilities": "^0.4.0",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-solid": "^1.57.0",
    "solid-js": "^1.9.3",
    "solid-sonner": "^0.3.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^10.0.2",
    "@wdio/globals": "^10.0.2",
    "@wdio/local-runner": "^10.0.2",
    "@wdio/mocha-framework": "^10.0.1",
    "@wdio/spec-reporter": "^10.0.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "packageManager": "pnpm@12.4.2"
}
